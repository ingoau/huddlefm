# Required
SLACK_WORKSPACE_URL=https://example.slack.com
SLACK_XOXP=xoxp-...
SLACK_XAPP=xapp-...
SLACK_XOXC=xoxc-...
SLACK_XOXD=xoxd-...

# Optional Slack behavior
# MANAGER_USER_ID=U0123456789
# WORKSPACE_ADMINS_AS_MANAGERS=false
# EXCLUDED_USER_IDS=U0123456789,U9876543210
# INTEGRATION_USER_IDS=U0123456789,U9876543210
# FORCE_COMPANION_CHANNEL_IDS=C0123456789,C9876543210
# SLACK_TEAM_ID=T0123456789
# SLACK_CANVAS_ID=F0123456789
# CANVAS_SECTIONS=summary,active sessions,top tracks,top artists,top videos,top video channels,top channels,controls,integrations
# FOOTER="*Need help?* Ask in <#C123>"

# Optional features
# LASTFM_API_KEY=replace-me
# LASTFM_SHARED_SECRET=replace-me
# OPENROUTER_API_KEY=sk-or-...
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
# LOCAL_CONTROL_TOKEN=replace-me

# Playback and limits
# QUEUE_LIMIT=50
# TRACK_DURATION_LIMIT_SECONDS=1200
# TRACK_DOWNLOAD_LIMIT_BYTES=100000000
# INITIAL_VOLUME=0.5
# DUCKING_MODE=gentle
# LOUDNESS_NORMALIZATION=true
# TRACK_PREPARATION_CONCURRENCY=2
# MEDIA_CACHE_LIMIT_BYTES=1000000000
# MEDIA_CACHE_MAX_AGE_DAYS=30
# ALONE_TIMEOUT_MS=120000
# IDLE_TIMEOUT_MS=600000
# PAUSED_TIMEOUT_MS=600000
# CHIME_MEDIA_REGION=ap-southeast-2

# Video mode
# VIDEO_DURATION_LIMIT_SECONDS=3600
# VIDEO_DOWNLOAD_LIMIT_BYTES=1500000000
# VIDEO_MAX_HEIGHT=720
# VIDEO_MAX_FPS=30
# VIDEO_SESSION_LIMIT=2
# VIDEO_CACHE_LIMIT_BYTES=5000000000

# Jellyfin: users linking their own servers
# JELLYFIN_ENABLED=true

# Runtime and logging
# BIND_ADDRESS=127.0.0.1
# PORT=3210
# LOG_LEVEL=info
# LOG_FILE=data/logs/huddlefm.jsonl
# LOG_FILE_SIZE=10m
# LOG_FILE_COUNT=7
